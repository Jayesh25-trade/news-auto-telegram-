# ========================================================
# 24x7 News & Market Intelligence Bot - Configuration
# ========================================================

# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRstuVWXyz

# Your personal Telegram User ID (get it from @userinfobot)
# Only this Telegram ID will be allowed to talk to and receive alerts from the bot
ALLOWED_USER_IDS=123456789

# Claude (Anthropic) API Key for Hinglish Summaries, Classification & RAG Q&A
# Get it from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# Claude Model
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# News Polling Interval in minutes (default: 2 minutes)
NEWS_POLL_INTERVAL_MINUTES=2

# Market Price Check Interval in minutes (default: 5 minutes)
MARKET_CHECK_INTERVAL_MINUTES=5

# Database Path
DB_PATH=data/intelligence_bot.db

# Backup Folder Path
BACKUP_DIR=data/backups

# Digest Mode Interval in minutes (for low-importance batching if enabled)
DIGEST_INTERVAL_MINUTES=30

# Timezone (Indian Standard Time)
TIMEZONE=Asia/Kolkata
